---
import BaseHead from "$components/BaseHead.astro";
import PageFrame from "$components/PageFrame.astro";

import { kSiteTitle, kSiteDescription } from "$consts";
---

<PageFrame pageType="home">
  <BaseHead slot="head" title={kSiteTitle} description={kSiteDescription} />

  <section class="home-hero" aria-label="Hero">
    <p class="home-hero-text">
      We All Struggle,
      <br />
      because life rarely turns out so neatly.
    </p>
  </section>
</PageFrame>
