---
import BaseHead from "$components/BaseHead.astro";
import PageFrame from "$components/PageFrame.astro";

import { kFriendLinks } from "$consts";
---

<PageFrame pageType="content-page">
  <BaseHead slot="head" title="Friend Link" description="Friend Link of Baihyf" />
  <main class="content-page">
    <article class="content-surface">
      <h1 class="post-title">Friend Links</h1>
      <div class="prose">
        <ul>
          {
            kFriendLinks.map((link) => (
              <li>
                <a href={link.url} target="_blank">
                  {link.name}
                </a>
                <p>{link.desc}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </article>
  </main>
</PageFrame>
