---
import BaseHead from "$components/BaseHead.astro";
import PageFrame from "$components/PageFrame.astro";
import FormattedDate from "$components/FormattedDate.astro";

import { kUrlBase, kSiteTitle, kSiteDescription } from "$consts";
import POSTS from "../../../content/snapshot/posts.json";
---

<PageFrame pageType="content-page">
  <BaseHead slot="head" title={kSiteTitle} description={kSiteDescription} />

  <main class="content-page">
    <section class="content-surface">
      <ul class="posts-list">
        {
          POSTS.map((post) => (
            <li>
              <a class="post-link" href={`${kUrlBase}/article/${post.id}/`}>
                <span class="post-date">
                  <FormattedDate date={new Date(post.date)} />
                </span>
                <span class="post-name">{post.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</PageFrame>
