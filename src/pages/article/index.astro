---
import { getCollection } from "astro:content";

import BaseHead from "$components/BaseHead.astro";
import PageFrame from "$components/PageFrame.astro";
import FormattedDate from "$components/FormattedDate.astro";

import { kUrlBase, kSiteTitle, kSiteDescription } from "$consts";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<PageFrame pageType="content-page">
  <BaseHead slot="head" title={kSiteTitle} description={kSiteDescription} />

  <main class="content-page">
    <section class="content-surface">
      <ul class="posts-list">
        {
          posts.map((post) => (
            <li>
              <a class="post-link" href={`${kUrlBase}/article/${post.id}/`}>
                <span class="post-date">
                  <FormattedDate date={post.data.date} />
                </span>
                <span class="post-name">{post.data.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</PageFrame>
