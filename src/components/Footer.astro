---
const today = new Date();
---

<footer class="site-footer-bar" dir="ltr">
  <div id="site-footer">
    BAIHEYUFEI
    <span class="year">&copy; 2023-{today.getFullYear()}</span>
  </div>

  <div class="bottom-controls">
    <button id="theme-toggle" type="button" aria-label="Toggle color theme">
      <span class="value">LIGHT</span>
    </button>
  </div>
</footer>

<style>
  #site-footer .year {
    font-weight: 400;
    opacity: 0.55;
    margin-inline-start: 0.5em;
    text-transform: none;
    letter-spacing: 0;
  }
</style>
