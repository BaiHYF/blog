---
import { kUrlBase, kSiteTitle } from "$consts";
---

<header class="site-header" dir="ltr">
  <a class="center-logo" href={`${kUrlBase}/`}>{kSiteTitle}</a>

  <nav class="top-nav" aria-label="Primary navigation">
    <div class="menu-trigger">
      <button
        class="menu-trigger-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-menu-links"
        aria-label="Open menu"
      >
        <span class="menu-label">MENU</span>
      </button>
    </div>

    <div class="menu-links" id="site-menu-links" hidden>
      <a class="nav-link" href={`${kUrlBase}/`}>Home</a>
      <a class="nav-link" href={`${kUrlBase}/article`}>Posts</a>
      <a class="nav-link" href={`${kUrlBase}/about`}>About</a>
    </div>
  </nav>
</header>
