---
import Header from "$components/Header.astro";
import Footer from "$components/Footer.astro";

interface Props {
  pageType?: string;
}

const { pageType = "" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <slot name="head" />
  </head>
  <body>
    <div class="background" aria-hidden="true"></div>
    <div class="site-frame">
      <Header />
      <div class="page" data-page-type={pageType}>
        <slot />
      </div>
      <Footer />
    </div>

    <script is:inline>
      (function () {
        const root = document.documentElement;
        const saved = localStorage.getItem("theme");
        const dark = saved
          ? saved === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        root.classList.toggle("dark", dark);

        const renderLabel = () => {
          const v = document.querySelector("#theme-toggle .value");
          if (v) v.textContent = root.classList.contains("dark") ? "DARK" : "LIGHT";
        };
        renderLabel();

        const toggle = document.getElementById("theme-toggle");
        if (toggle) {
          toggle.addEventListener("click", () => {
            root.classList.toggle("dark");
            localStorage.setItem("theme", root.classList.contains("dark") ? "dark" : "light");
            renderLabel();
          });
        }

        const menuBtn = document.querySelector(".menu-trigger-toggle");
        const menu = document.getElementById("site-menu-links");
        if (menuBtn && menu) {
          menuBtn.addEventListener("click", () => {
            menu.hidden = !menu.hidden;
            menuBtn.setAttribute("aria-expanded", String(!menu.hidden));
            document.body.classList.toggle("mobile-menu-open", !menu.hidden);
          });
        }
      })();
    </script>
  </body>
</html>
