---
import type { CollectionEntry } from "astro:content";

import BaseHead from "$components/BaseHead.astro";
import PageFrame from "$components/PageFrame.astro";
import FormattedDate from "$components/FormattedDate.astro";

interface IdExt {
  id: string;
}

type Props = CollectionEntry<"blog">["data"] & (IdExt | { id: false });

const { id, title, description, date, updatedDate } = Astro.props;
---

<PageFrame pageType="content-page">
  <BaseHead slot="head" title={title} description={description} />

  <main class="content-page">
    <article class="content-surface">
      <header class="post-meta">
        <span class="post-date">
          <FormattedDate date={date} />
          {
            updatedDate && (
              <span class="last-updated-on"> · updated&nbsp;</span>
            )
          }
        </span>
        <h1 class="post-title">{title}</h1>
      </header>

      <div class="prose">
        <slot />
      </div>
    </article>
  </main>
</PageFrame>
